{
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "redirects": [
    {
      "source": "/blog/%E0%A4%9C%E0%A4%AC-%E0%A4%9C%E0%A5%80%E0%A4%B5%E0%A4%A8-%E0%A4%B8%E0%A5%8D%E0%A4%B5%E0%A4%AF%E0%A4%82-%E0%A4%89%E0%A4%AA%E0%A4%A6%E0%A5%87%E0%A4%B6-%E0%A4%AC%E0%A4%A8-%E0%A4%9C%E0%A4%BE%E0%A4%8F",
      "destination": "/blog/life-itself-a-teaching",
      "permanent": true
    },
    {
      "source": "/blog/जब-जीवन-स्वयं-उपदेश-बन-जाए",
      "destination": "/blog/life-itself-a-teaching",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|assets/|favicon\\.png|icon-192\\.png|icon-512\\.png|sw\\.js|manifest\\.webmanifest|audio/|robots\\.txt|.*\\.(?:ico|png|jpg|jpeg|svg|gif|webp|woff2?|ttf|otf|css|js|json|map|txt|xml|webmanifest)).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
